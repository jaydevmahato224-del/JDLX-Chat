FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000

WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend /app
RUN mkdir -p /app/static/uploads /app/static/downloads

EXPOSE 10000

# migrations_boot is idempotent and uses the same Turso/SQLite schema as the
# main backend.  Do not run two different migration mechanisms here.
# threads 32 (was 8): every open chat holds a thread in a 3-4s long-poll, so
# 2x8=16 slots served only ~8 concurrent users and new sends queued until the
# client's 35s abort. 2x32=64 slots keeps sends off the queue; override with
# GUNICORN_THREADS on the host if needed.
CMD ["sh", "-c", "python migrations_boot.py && exec gunicorn --bind 0.0.0.0:${PORT} --worker-class gthread --workers ${WEB_CONCURRENCY:-2} --threads ${GUNICORN_THREADS:-32} --timeout 120 --access-logfile - --error-logfile - chat_app:app"]
