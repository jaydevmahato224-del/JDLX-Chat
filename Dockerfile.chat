FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=10000

WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend /app
RUN mkdir -p /app/static/uploads /app/static/downloads

EXPOSE 10000

# migrations_boot is idempotent and uses the same Turso/SQLite schema as the
# main backend.  Do not run two different migration mechanisms here.
CMD ["sh", "-c", "python migrations_boot.py && exec gunicorn --bind 0.0.0.0:${PORT} --workers ${WEB_CONCURRENCY:-2} --timeout 120 --access-logfile - --error-logfile - chat_app:app"]
