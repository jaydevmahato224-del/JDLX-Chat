# Copy to .env (git-ignored) before `docker compose up -d`.
#
# Public IPv4 of this server. Behind a 1:1 NAT cloud (EC2 / GCP / Azure) use
# "PUBLIC_IP/PRIVATE_IP", e.g. 203.0.113.10/10.0.0.5
PUBLIC_IP=

# Shared secret for the rotating credentials: openssl rand -hex 32
# The SAME value must be set on the chat backend as TURN_SECRET.
TURN_SECRET=

# Cosmetic, but must stay stable: clients see it during the auth challenge.
TURN_REALM=jdlx.chat
